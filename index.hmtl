    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }

    .step {
      text-align: center;
    }

    .step-number {
      width: 31px;
      height: 31px;

      margin: 0 auto 6px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 50%;

      background: #202025;
      border: 1px solid #35353c;

      color: #888891;

      font-size: 11px;
      font-weight: 900;
    }

    .step.active .step-number {
      background: var(--pink);
      border-color: var(--pink);

      color: #fff;

      box-shadow:
        0 0 18px rgba(255,45,135,.32);
    }

    .step-text {
      color: #888891;

      font-size: 10px;
      font-weight: 700;
      line-height: 1.3;
    }

    .step.active .step-text {
      color: #fff;
    }

    /* =========================
       BOTÃO
    ========================= */

    .cta-area {
      padding: 0 21px 20px;
    }

    .cta {
      width: 100%;
      min-height: 62px;

      display: flex;
      align-items: center;
      justify-content: center;
      gap: 9px;

      padding: 16px;

      border-radius: 16px;

      text-decoration: none;

      color: #fff;

      background:
        linear-gradient(
          135deg,
          #ff176d 0%,
          #ff3987 48%,
          #ff176d 100%
        );

      background-size: 200% 200%;

      font-size: 14px;
      font-weight: 900;
      letter-spacing: .15px;

      box-shadow:
        0 14px 38px rgba(255,23,109,.28),
        inset 0 1px 0 rgba(255,255,255,.18);

      transition:
        transform .2s ease,
        box-shadow .2s ease;

      animation:
        pulse 2.5s ease-in-out infinite,
        gradientMove 4s ease infinite;
    }

    .cta:hover {
      transform: translateY(-2px);

      box-shadow:
        0 18px 50px rgba(255,23,109,.43),
        inset 0 1px 0 rgba(255,255,255,.2);
    }

    .cta-arrow {
      font-size: 20px;
      transition: transform .2s ease;
    }

    .cta:hover .cta-arrow {
      transform: translateX(4px);
    }

    .cta-subtitle {
      text-align: center;

      color: #6f6f78;

      font-size: 10px;

      margin-top: 9px;
    }

    /* =========================
       CONFIANÇA
    ========================= */

    .security {
      margin: 0 21px 21px;

      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;

      padding: 13px;

      border-radius: 14px;

      background: rgba(69,214,154,.045);
      border: 1px solid rgba(69,214,154,.11);
    }

    .security-icon {
      color: var(--green);
      font-size: 15px;
    }

    .security-text {
      color: #89948f;

      font-size: 10px;
      line-height: 1.4;
    }

    .security-text strong {
      color: #b7c4bf;
    }

    /* =========================
       RODAPÉ
    ========================= */

    .footer {
      text-align: center;

      padding: 0 20px 23px;

      color: #505057;

      font-size: 9px;
      line-height: 1.55;
    }

    /* =========================
       ANIMAÇÕES
    ========================= */

    @keyframes pulse {
      0%,100% {
        box-shadow:
          0 14px 38px rgba(255,23,109,.27),
          inset 0 1px 0 rgba(255,255,255,.18);
      }

      50% {
        box-shadow:
          0 14px 52px rgba(255,23,109,.44),
          inset 0 1px 0 rgba(255,255,255,.18);
      }
    }

    @keyframes gradientMove {
      0% {
        background-position: 0% 50%;
      }

      50% {
        background-position: 100% 50%;
      }

      100% {
        background-position: 0% 50%;
      }
    }

    /* =========================
       CELULAR
    ========================= */

    @media (max-width: 430px) {

      .topbar {
        height: 60px;
      }

      .logo {
        font-size: 25px;
      }

      .page {
        padding: 18px 10px 30px;
      }

      .card {
        border-radius: 23px;
      }

      .header {
        padding: 28px 17px 19px;
      }

      h1 {
        font-size: 27px;
      }

      .subtitle {
        font-size: 13px;
      }

      .alert,
      .benefits {
        margin-left: 15px;
        margin-right: 15px;
      }

      .steps-area {
        padding-left: 15px;
        padding-right: 15px;
      }

      .cta-area {
        padding-left: 15px;
        padding-right: 15px;
      }

      .security {
        margin-left: 15px;
        margin-right: 15px;
      }
    }

    @media (max-width: 350px) {

      h1 {
        font-size: 24px;
      }

      .cta {
        font-size: 12px;
      }

      .benefit {
        font-size: 11px;
      }
    }
  </style>
</head>

<body>

  <header class="topbar">
    <div class="logo">
      <span>privacy</span>
    </div>
  </header>

  <main class="page">

    <section class="card">

      <!-- CABEÇALHO -->

      <div class="header">

        <div class="status">
          <span class="status-dot"></span>
          Confirmação necessária
        </div>

        <div class="warning">
          !
        </div>

        <h1>
          Seu acesso está<br>
          <span class="gradient">quase liberado</span>
        </h1>

        <p class="subtitle">
          O pagamento ainda não foi confirmado.
          Conclua sua compra para que a confirmação
          possa ser processada e o acesso seja
          disponibilizado.
        </p>

      </div>

      <!-- ALERTA -->

      <div class="alert">

        <div class="alert-title">
          <span class="alert-title-icon">●</span>
          PAGAMENTO AINDA NÃO CONFIRMADO
        </div>

        <div class="alert-text">
          Para receber o acesso, é necessário finalizar
          o pagamento através do checkout. O conteúdo
          permanece bloqueado até que a confirmação
          seja recebida.
        </div>

      </div>

      <!-- BENEFÍCIOS -->

      <div class="benefits">

        <div class="benefits-title">
          Depois da confirmação, <span>o que acontece?</span>
        </div>

        <div class="benefit-list">

          <div class="benefit">
            <div class="check">✓</div>
            <span>O pagamento será processado</span>
          </div>

          <div class="benefit">
            <div class="check">✓</div>
            <span>A confirmação da compra será registrada</span>
          </div>

          <div class="benefit">
            <div class="check">✓</div>
            <span>O acesso poderá ser liberado após a confirmação</span>
          </div>

        </div>

      </div>

      <!-- ETAPAS -->

      <div class="steps-area">

        <div class="steps-title">
          Complete sua solicitação
        </div>

        <div class="steps">

          <div class="step active">

            <div class="step-number">
              1
            </div>

            <div class="step-text">
              Voltar ao<br>
              checkout
            </div>

          </div>

          <div class="step">

            <div class="step-number">
              2
            </div>

            <div class="step-text">
              Finalizar<br>
              pagamento
            </div>

          </div>

          <div class="step">

            <div class="step-number">
              3
            </div>

            <div class="step-text">
              Receber<br>
              confirmação
            </div>

          </div>

        </div>

      </div>

      <!-- CTA -->

      <div class="cta-area">

        <a
          class="cta"
          href="https://checkoutonline.org.ua/c/5a34e1720c"
        >
          CONTINUAR PARA O PAGAMENTO

          <span class="cta-arrow">
            →
          </span>
        </a>

        <div class="cta-subtitle">
          Você será direcionado ao checkout para concluir sua compra.
        </div>

      </div>

      <!-- SEGURANÇA -->

      <div class="security">

        <div class="security-icon">
          ✓
        </div>

        <div class="security-text">
          <strong>Processo protegido</strong><br>
          A liberação depende da confirmação do pagamento.
        </div>

      </div>

      <!-- RODAPÉ -->

      <div class="footer">
        Ao concluir o pagamento, aguarde o processamento da confirmação.
        <br>
        © 2026 — Sistema de acesso
      </div>

    </section>

  </main>

</body>
</html>
```
